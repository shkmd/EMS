# Database (MySQL)
# Use 127.0.0.1, not "localhost": on Windows + WSL2 + Docker Desktop,
# "localhost" can resolve to the IPv6 loopback (::1) first, which Prisma's
# query engine fails to connect through even when the IPv4 port works fine.
DATABASE_URL="mysql://ems_user:ems_password@127.0.0.1:3306/ems_db"

# Only used by docker-compose.yml to set the `db` container's credentials —
# MUST be changed from the default before deploying anywhere reachable from
# the internet. Generate with: openssl rand -base64 24
MYSQL_PASSWORD="ems_password"
MYSQL_ROOT_PASSWORD="ems_root_password"

# JWT (access tokens only — refresh tokens are opaque random strings, hashed
# in the database, not JWTs; see src/features/auth)
# PRODUCTION: replace with a real random secret — generate with:
#   openssl rand -base64 48
JWT_SECRET="change-me-access-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# App
# PRODUCTION: must be the real https:// URL you deploy to — auth cookies are
# marked Secure in production (NODE_ENV=production), so login silently fails
# over plain http:// or a mismatched origin. Reset/notification emails also
# link back to this URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Only used by docker-compose.prod.yml (Caddy reverse proxy) — the public
# domain name pointed at your server's IP. Caddy automatically obtains and
# renews a Let's Encrypt TLS certificate for it.
DOMAIN="ems.yourcompany.com"

# SMTP (for password reset / notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="user@example.com"
SMTP_PASSWORD="smtp-password"
SMTP_FROM_NAME="EMS"
SMTP_FROM_EMAIL="no-reply@example.com"

# File uploads — deliberately NOT under public/: employee documents (ID
# proof, PAN, Aadhaar, etc.) must never be reachable by a static/guessable
# URL. Files are streamed through an authenticated API route instead.
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB="10"

# Seed / bootstrap admin
# PRODUCTION: change the password — this is the very first login and the
# account that can create every other user, so a default password here is a
# real hole, not a placeholder.
SEED_SUPER_ADMIN_EMAIL="admin@ems.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# Biometric device integration — shared secret the office bridge script (that
# reads the fingerprint device's punch log and posts it to
# /api/integrations/biometric/punch) authenticates with, since it runs
# unattended with no user session. Leave unset to disable the endpoint.
# Generate with: openssl rand -base64 24
BIOMETRIC_SYNC_API_KEY=""

# WebRTC calling — TURN_SECRET must exactly match coturn's
# static-auth-secret on the server running coturn (see /etc/turnserver.conf).
# TURN_HOST is the public hostname/IP coturn listens on (port 3478).
# Leave both unset to disable calling.
TURN_SECRET=""
TURN_HOST=""
